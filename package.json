{
  "name": "ow-perk-api",
  "version": "1.0.0",
  "description": "Overlooker 통계를 기반으로 오버워치 특전 선택률을 제공하는 Discord 봇/API 서버",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "clear-commands": "node src/clear-commands.js",
    "sync:perks-ko": "node scripts/sync-ko-perks.js",
    "sync:perk-snapshots": "node scripts/sync-perk-snapshots.js",
    "sync:relations:candidates": "node scripts/sync-overpicker-relations.js",
    "validate:relations": "node scripts/validate-relations.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "discord.js": "^14.21.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1"
  }
}
